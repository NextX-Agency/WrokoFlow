# WrokoFlow - Environment Variables
# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth (for Google Calendar integration)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# Database (for migration script only — not used by the frontend)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Resend (set as a Supabase Edge Function secret, not in frontend .env)
# Run: supabase secrets set RESEND_API_KEY=re_your_resend_api_key
# Run: supabase secrets set SENDER_EMAIL=notifications@yourdomain.com
